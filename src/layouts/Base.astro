---
import "@fontsource-variable/instrument-sans";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Signal — ship infrastructure your developers won't hate",
  description = "Signal is a concept developer-platform landing page — part of the Nathan AI Solutions portfolio.",
} = Astro.props;
const FAVICON =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='oklch(0.6 0.2 295)'/%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={FAVICON} />
  </head>
  <body>
    <slot />
  </body>
</html>
